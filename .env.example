# Copy to .env and fill in. Never commit .env.

# Required: Gemini judges whether each VM is affected by a CVE
GOOGLE_API_KEY=
# Optional: override the default judge model
# GEMINI_MODEL=gemini-4-carbon

# boxd token for snapshot/clone fix tests (`boxd auth keys create watchdog`)
BOXD_TOKEN=
# Venice AI key for exploit proof-of-concept generation
VENICE_API_KEY=

# Optional: where your SSH keys/config and boxd keys live (defaults shown)
# SSH_DIR=~/.ssh
# BOXD_DIR=~/AppData/Roaming/boxd
